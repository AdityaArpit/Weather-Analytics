[TEMPLATE]
# Backend API base URL (leave empty in production when same-origin)
VITE_API_BASE_URL="http://localhost:5000"
# Supabase project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=
# Supabase publishable (anon) key — safe for browser use. NEVER put secret keys here.
VITE_SUPABASE_PUBLISHABLE_KEY=
