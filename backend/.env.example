# ---------------------------------------------------------------------------
# Aapda Drishti backend environment template.
# Copy to backend/.env and fill in values. Never commit real secrets.
# ---------------------------------------------------------------------------

PORT=5000
APP_URL="http://localhost:5000"
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# --- Supabase (server-only; publishable key goes to the frontend env) ------
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Publishable anon key (safe for client use)
SUPABASE_PUBLISHABLE_KEY=
# Service role / secret key. NEVER expose to the frontend.
SUPABASE_SECRET_KEY=

# --- Background jobs (server-to-server scheduling auth) --------------------
# Required for POST /api/jobs/*. Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Groq (LLM + STT + TTS) ------------------------------------------------
GROQ_API_KEY=
# Optional rotating key pool (comma separated or numbered vars)
GROQ_API_KEYS=
GROQ_API_KEY_01=
GROQ_API_KEY_02=
GROQ_API_KEY_03=
GROQ_BASE_URL=
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_MODEL_FALLBACKS="qwen/qwen3.8-27b"
GROQ_STT_MODEL="whisper-large-v3-turbo"
GROQ_TTS_MODEL="canopylabs/orpheus-v1-english"
GROQ_TTS_VOICE="austin"
GROQ_MAX_CONCURRENCY=8
GROQ_PER_KEY_CONCURRENCY=1
GROQ_MAX_RETRIES=3

# --- Gemini Embedding 2 (pgvector vector(1536)) ----------------------------
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=1536

# --- External sources ------------------------------------------------------
SOURCE_GOOGLE_NEWS_ENABLED=true
SOURCE_SACHET_ENABLED=true

# --- Notification providers ------------------------------------------------
# Email: resend | smtp
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM="Aapda Drishti <alerts@yourdomain.in>"
# SMS: twilio
SMS_PROVIDER=twilio
SMS_API_KEY=
SMS_ACCOUNT_SID=
SMS_FROM_NUMBER=

# Optional multi-source research providers (YouTube / Reddit / data.gov.in).
# Without keys those providers are skipped by the capability registry.
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
DATA_GOV_API_KEY=

# --- Job / cache tuning ----------------------------------------------------
PRESENT_REFRESH_SECONDS=60
RECONCILIATION_INTERVAL_HOURS=6

CACHE_PRESENT_TTL_SECONDS=60
CACHE_PAST_TTL_SECONDS=300
CACHE_SEARCH_TTL_SECONDS=900
CACHE_CHAT_TTL_SECONDS=900

# --- Citizen report constraints -------------------------------------------
# Maximum acceptable GPS accuracy (meters) for a report to be accepted.
REPORT_MAX_ACCURACY_METERS=150
# Matching radius (meters) when linking a report to nearby canonical events.
REPORT_RADIUS_METERS=5000
